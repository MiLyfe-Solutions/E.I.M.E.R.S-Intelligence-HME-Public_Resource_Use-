{
  "name": "eimers-ai-kpi-panel-backend",
  "version": "1.0.0",
  "description": "EIMERS AI KPI Control Panel — Backend API for proof pack recording, governance, and license validation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "test:staging": "jest --env=staging",
    "test:e2e": "npm run migrate:test && jest --testPathPattern=e2e",
    "migrate": "psql -h $DB_HOST -U postgres -d apex -f ./migrations.sql",
    "migrate:staging": "psql -h $DB_HOST_STAGING -U postgres -d apex -f ./migrations.sql",
    "health-check": "curl http://localhost:3000/api/v1/health",
    "smoke-test": "npm run health-check && curl -X POST http://localhost:3000/api/v1/proof-packs/record -H 'Content-Type: application/json' -H 'Authorization: Bearer TEST_TOKEN' -d '{\"operation_id\": \"TEST-SMOKE-001\", \"component\": \"test\", \"action\": \"TEST\"}'"
  },
  "keywords": [
    "APEX",
    "EIMERS",
    "AI",
    "KPI",
    "governance",
    "proof-packs",
    "patent",
    "license-validation"
  ],
  "author": "Joshua Eimers / MiLyfe Technologies LLC",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.1.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "dotenv-cli": "^7.3.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MiLyfe-Solutions/apex-engine.git"
  },
  "bugs": {
    "url": "https://github.com/MiLyfe-Solutions/apex-engine/issues"
  }
}
