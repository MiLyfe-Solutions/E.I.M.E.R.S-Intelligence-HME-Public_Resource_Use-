theorem pushSample_checked : allDrop pushSample = true := by decide +kernel

/-- every sampled push family drops below its start, for every t -/
theorem pushSample_drop : ∀ p ∈ pushSample, ∀ t,
    iter p.2.2 (p.1 + 2 ^ p.2.1 * t) < p.1 + 2 ^ p.2.1 * t :=
  allDrop_sound pushSample pushSample_checked

/-- negative control: the all-ones residue 2^20 - 1 at 2^20 is refused -/
example : famDrop (2 ^ 20 - 1) 20 60 = false := by decide

#print axioms famDrop_sound
#print axioms pushSample_drop

end FamilyDrop
