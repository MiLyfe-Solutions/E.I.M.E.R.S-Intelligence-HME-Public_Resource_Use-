import Mathlib

/-!
Reusable soundness layer for finite accelerated odd-to-odd descent certificates.

This module proves the algebraic implication from a verified path and a strict
margin to descent. It does NOT yet import the 113,481 JSON records, prove their
residue-class path fields, or prove that their classes cover all odd integers.
-/

namespace EimersCertificateSoundness

/-- Total exponent of 2 removed by a finite valuation word. -/
def valuationSum : List ℕ → ℕ
  | [] => 0
  | v :: vs => v + valuationSum vs

/-- Affine offset generated by the valuation word, read from first step onward. -/
def valuationBias : List ℕ → ℕ
  | [] => 0
  | v :: vs => 3 ^ vs.length + 2 ^ v * valuationBias vs

/--
A path record says each transition is exactly `3*x+1 = 2^v*y` with odd input
and odd output. The odd output makes `v` the full power of two removed at that
step, so this relation describes the accelerated odd-to-odd transition.
-/
def CertifiedOddPath : ℕ → List ℕ → ℕ → Prop
  | n, [], z => z = n
  | n, v :: vs, z =>
      ∃ y, n % 2 = 1 ∧ 3 * n + 1 = 2 ^ v * y ∧ y % 2 = 1 ∧
        CertifiedOddPath y vs z

/-- Compose the exact step equations into the certificate's affine identity. -/
theorem affine_of_certifiedOddPath {n z : ℕ} {vs : List ℕ}
    (hpath : CertifiedOddPath n vs z) :
    2 ^ valuationSum vs * z = 3 ^ vs.length * n + valuationBias vs := by
  induction vs generalizing n z with
  | nil =>
      simp [CertifiedOddPath, valuationSum, valuationBias] at hpath ⊢
      subst z
      simp [valuationSum, valuationBias]
  | cons v vs ih =>
      simp only [CertifiedOddPath] at hpath
      rcases hpath with ⟨y, hnodd, hstep, hyodd, htail⟩
      change 2 ^ (v + valuationSum vs) * z =
        3 ^ (vs.length + 1) * n +
          (3 ^ vs.length + 2 ^ v * valuationBias vs)
      calc
        2 ^ (v + valuationSum vs) * z =
            2 ^ v * (2 ^ valuationSum vs * z) := by
              rw [pow_add]
              ring
        _ = 2 ^ v * (3 ^ vs.length * y + valuationBias vs) := by
              rw [ih htail]
        _ = 3 ^ vs.length * (2 ^ v * y) +
              2 ^ v * valuationBias vs := by ring
        _ = 3 ^ vs.length * (3 * n + 1) +
              2 ^ v * valuationBias vs := by rw [← hstep]
        _ = 3 ^ (vs.length + 1) * n +
              (3 ^ vs.length + 2 ^ v * valuationBias vs) := by
              rw [pow_succ]
              ring

/-- The affine identity plus a strict margin implies endpoint descent. -/
theorem strict_descent_of_affine {n z s k B : ℕ}
    (haffine : 2 ^ s * z = 3 ^ k * n + B)
    (hmargin : 3 ^ k * n + B < 2 ^ s * n) :
    z < n := by
  by_contra hnot
  have hnz : n ≤ z := by omega
  have hmul : 2 ^ s * n ≤ 2 ^ s * z := Nat.mul_le_mul_left _ hnz
  have hcontr : 2 ^ s * n ≤ 3 ^ k * n + B := by
    calc
      2 ^ s * n ≤ 2 ^ s * z := hmul
      _ = 3 ^ k * n + B := haffine
  omega

/--
A residue certificate contains the finite data and the obligations needed for
all members of its residue class. `path_for_member` is the remaining formal
bridge an importer must prove from the stored valuation word and modulus.
-/
structure OddResidueDescentCertificate (r b : ℕ) where
  valuations : List ℕ
  endpoint : ℕ → ℕ
  canonical_residue : r < 2 ^ b
  precision : valuationSum valuations < b
  exponent_gap : 3 ^ valuations.length < 2 ^ valuationSum valuations
  strict_margin : valuationBias valuations <
    (2 ^ valuationSum valuations - 3 ^ valuations.length) * r
  path_for_member : ∀ n, n % 2 ^ b = r →
    CertifiedOddPath n valuations (endpoint n)

/-- Every member of a valid residue certificate descends under its recorded path. -/
theorem every_member_descends {r b : ℕ}
    (cert : OddResidueDescentCertificate r b) {n : ℕ}
    (hclass : n % 2 ^ b = r) : cert.endpoint n < n := by
  have hrn : r ≤ n := by
    calc
      r = n % 2 ^ b := hclass.symm
      _ ≤ n := Nat.mod_le _ _
  have hgap : 3 ^ cert.valuations.length < 2 ^ valuationSum cert.valuations :=
    cert.exponent_gap
  have hdelta_pos : 0 <
      2 ^ valuationSum cert.valuations - 3 ^ cert.valuations.length :=
    Nat.sub_pos_of_lt hgap
  have hdelta_mul := Nat.mul_le_mul_left
    (2 ^ valuationSum cert.valuations - 3 ^ cert.valuations.length) hrn
  have hmargin_n : valuationBias cert.valuations <
      (2 ^ valuationSum cert.valuations - 3 ^ cert.valuations.length) * n :=
    lt_of_lt_of_le cert.strict_margin hdelta_mul
  have hcoeff : 3 ^ cert.valuations.length +
      (2 ^ valuationSum cert.valuations - 3 ^ cert.valuations.length) =
      2 ^ valuationSum cert.valuations := by omega
  have hbound : 3 ^ cert.valuations.length * n + valuationBias cert.valuations <
      2 ^ valuationSum cert.valuations * n := by
    calc
      3 ^ cert.valuations.length * n + valuationBias cert.valuations <
          3 ^ cert.valuations.length * n +
            (2 ^ valuationSum cert.valuations - 3 ^ cert.valuations.length) * n :=
        Nat.add_lt_add_left hmargin_n _
      _ = (3 ^ cert.valuations.length +
            (2 ^ valuationSum cert.valuations - 3 ^ cert.valuations.length)) * n := by
        rw [← Nat.add_mul]
      _ = 2 ^ valuationSum cert.valuations * n := by rw [hcoeff]
  exact strict_descent_of_affine
    (affine_of_certifiedOddPath (cert.path_for_member n hclass)) hbound

#print axioms affine_of_certifiedOddPath
#print axioms strict_descent_of_affine
#print axioms every_member_descends

end EimersCertificateSoundness
