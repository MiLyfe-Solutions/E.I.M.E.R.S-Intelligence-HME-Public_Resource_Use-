/-
Affine Margin Transport core v4.
STATUS: DRAFT — algebraically replayed locally, NOT Lean-kernel checked in this container.
Target: Lean 4.35.0 + Mathlib in an additive isolated project.

Changes from v3:
- adds a direct fixed-tail-word recurrence `collatzConstTail`;
- proves the repeated-tail defect by induction on the shared valuation word.

Earlier changes:
- derives the repeated-tail defect from the actual affine-constant recurrence;
- keeps equality of cumulative tail powers explicit as a guard;
- adds a generic recurrent-tail theorem by induction;
- retains corrected-margin transport as the authorization rule.

Universal Collatz remains HOLD_UNPROVEN.
-/

import Mathlib

namespace AffineProofTransport

/-- Affine descent margin for a block `m*y = a*n + C`. -/
def margin (m a n C : Int) : Int := (m - a) * n - C

/-- Exact margin cocycle under source translation `T` and constant change `dC`. -/
theorem affine_margin_transport_identity
    (m a n C T dC : Int) :
    margin m a (n + T) (C + dC)
      = margin m a n C + ((m - a) * T - dC) := by
  unfold margin
  ring

/-- Positivity transports whenever the corrected target margin is positive. -/
theorem affine_margin_transport_positive
    (m a n C T dC : Int)
    (hpos : 0 < margin m a n C + ((m - a) * T - dC)) :
    0 < margin m a (n + T) (C + dC) := by
  rw [affine_margin_transport_identity]
  exact hpos

/-- A reusable lower bound can authorize transport without reproving the full source margin. -/
theorem affine_margin_transport_from_lower_bound
    (m a n C T dC L : Int)
    (hL : L <= margin m a n C)
    (hpos : 0 < L + ((m - a) * T - dC)) :
    0 < margin m a (n + T) (C + dC) := by
  rw [affine_margin_transport_identity]
  linarith

/-- Two consecutive source/constant translations add their defects exactly. -/
theorem affine_margin_transport_compose
    (m a n C T1 T2 dC1 dC2 : Int) :
    margin m a (n + T1 + T2) (C + dC1 + dC2)
      = margin m a n C
        + ((m - a) * T1 - dC1)
        + ((m - a) * T2 - dC2) := by
  unfold margin
  ring

/-- One Collatz affine-constant update at cumulative valuation sum `S`.
    If `2^S*y = 3^k*n + C`, appending one accelerated odd step gives
    the next constant `3*C + 2^S` before accounting for the next divisor. -/
def collatzConstStep (C : Int) (S : Nat) : Int :=
  3 * C + (2 : Int) ^ S

/-- With the same cumulative `S`, one shared tail step triples the constant defect. -/
theorem collatz_common_tail_defect_step
    (C C' : Int) (S : Nat) :
    collatzConstStep C' S - collatzConstStep C S = 3 * (C' - C) := by
  unfold collatzConstStep
  ring

/-- Generic common-tail recurrence: if two affine constants are updated by the
    same multiplier and the same additive term at every tail step, then their
    defect after `r` steps is multiplied by `a^r`.

    This proves the repeated-tail formula from the recurrence rather than
    assuming the final formula as a hypothesis. -/
theorem common_tail_defect_recurrence
    (a : Int) (C C' B : Nat -> Int) (h : Nat)
    (hC  : forall j : Nat, C  (j + 1) = a * C  j + B j)
    (hC' : forall j : Nat, C' (j + 1) = a * C' j + B j) :
    forall r : Nat,
      C' (h + r) - C (h + r) = a ^ r * (C' h - C h) := by
  intro r
  induction r with
  | zero => simp
  | succ r ihr =>
      rw [Nat.add_succ, hC', hC, ihr]
      ring

/-- Collatz specialization of the common-tail recurrence.  `pow2S j` is the
    shared additive term `2^(S_j)` generated by equal cumulative valuation
    sums along the common tail. -/
theorem collatz_common_tail_defect_pow_three
    (C C' pow2S : Nat -> Int) (h : Nat)
    (hC  : forall j : Nat, C  (j + 1) = 3 * C  j + pow2S j)
    (hC' : forall j : Nat, C' (j + 1) = 3 * C' j + pow2S j) :
    forall r : Nat,
      C' (h + r) - C (h + r) = (3 : Int) ^ r * (C' h - C h) := by
  exact common_tail_defect_recurrence 3 C C' pow2S h hC hC'


/-- Execute only the affine-constant recurrence along a fixed accelerated
    valuation tail word. `S` is the cumulative valuation sum on entry to the
    tail and `C` is the incoming affine constant.

    Each shared odd step updates
      `C_next = 3*C + 2^S`
    and advances `S` by that step's exact valuation. -/
def collatzConstTail : List Nat -> Nat -> Int -> Int
  | [],      _, C => C
  | a :: ws, S, C =>
      collatzConstTail ws (S + a) (3 * C + (2 : Int) ^ S)

/-- A shared exact valuation tail multiplies the incoming affine-constant
    defect by exactly `3^(tail length)`.  The theorem derives the result from
    the step recurrence and therefore does not assume the endpoint formula. -/
theorem collatzConstTail_defect
    (w : List Nat) (S : Nat) (C C' : Int) :
    collatzConstTail w S C' - collatzConstTail w S C
      = (3 : Int) ^ w.length * (C' - C) := by
  induction w generalizing S C C' with
  | nil =>
      simp [collatzConstTail]
  | cons a w ih =>
      simp only [collatzConstTail]
      rw [ih]
      simp only [List.length_cons, pow_succ]
      ring

/-- One shared affine tail update multiplies the constant defect by the common multiplier. -/
theorem common_tail_constant_cocycle_scalar
    (a C C' B : Int) :
    (a * C' + B) - (a * C + B) = a * (C' - C) := by
  ring

/-- If the incoming constant defect is `dC`, one shared update makes it `a*dC`. -/
theorem common_tail_constant_cocycle_step
    (a C C' B dC : Int)
    (h : C' - C = dC) :
    (a * C' + B) - (a * C + B) = a * dC := by
  calc
    (a * C' + B) - (a * C + B) = a * (C' - C) := by ring
    _ = a * dC := by rw [h]

/-- Positive affine margin implies strict descent when `m>0` and
    `m*y = a*n + C`; stated over integers to avoid division. -/
theorem positive_margin_implies_scaled_descent
    (m a n C y : Int)
    (hm : 0 < m)
    (haff : m * y = a * n + C)
    (hmargin : 0 < margin m a n C) :
    y < n := by
  unfold margin at hmargin
  have hscaled : m * y < m * n := by
    rw [haff]
    linarith
  exact (mul_lt_mul_left hm).mp hscaled

end AffineProofTransport
