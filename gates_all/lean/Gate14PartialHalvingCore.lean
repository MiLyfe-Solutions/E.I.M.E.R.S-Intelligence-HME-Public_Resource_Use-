import Lean.Elab.Tactic.Omega

namespace CPOQGate14

/-- Finite reachability generated by the two ordinary Collatz rules.
    This research core is a candidate until the pinned Lean replay succeeds. -/
inductive OrdinaryReach : Nat -> Nat -> Prop
  | refl (x : Nat) : OrdinaryReach x x
  | even (y : Nat) : OrdinaryReach (2 * y) y
  | odd (x : Nat) (hx : x % 2 = 1) : OrdinaryReach x (3 * x + 1)
  | trans {x y z : Nat} : OrdinaryReach x y -> OrdinaryReach y z -> OrdinaryReach x z

/-- Stop after d ordinary halvings, whether the endpoint is odd or even. -/
theorem power_two_halving (d y : Nat) : OrdinaryReach (2^d * y) y := by
  induction d with
  | zero => simpa using OrdinaryReach.refl y
  | succ d ih =>
    have hs : OrdinaryReach (2^(d+1) * y) (2^d * y) := by
      simpa [Nat.pow_add, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm]
        using OrdinaryReach.even (2^d * y)
    exact OrdinaryReach.trans hs ih

theorem partial_halving_reach (x y d : Nat)
    (hx : x % 2 = 1) (h : 3*x+1 = 2^d*y) : OrdinaryReach x y := by
  have hh : OrdinaryReach (3*x+1) y := by
    rw [h]
    exact power_two_halving d y
  exact OrdinaryReach.trans (OrdinaryReach.odd x hx) hh

/-- The endpoint need not be odd. Base and slope inequalities imply descent
    below N + M*k for every nonnegative integer parameter k. -/
theorem affine_partial_halving_descent
    (A B U V N M d k : Nat)
    (hA : A % 2 = 1) (hB : B % 2 = 0)
    (hbase : 3*A+1 = 2^d*U) (hslope : 3*B = 2^d*V)
    (hgap : U < N) (hs : V <= M) :
    OrdinaryReach (A+B*k) (U+V*k) /\ U+V*k < N+M*k := by
  have hodd : (A+B*k) % 2 = 1 := by
    simp [Nat.add_mod, Nat.mul_mod, hA, hB]
  have hpartial : 3*(A+B*k)+1 = 2^d*(U+V*k) := by
    calc
      3*(A+B*k)+1 = (3*A+1)+(3*B)*k := by
        simp [Nat.mul_add, Nat.mul_assoc, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
      _ = 2^d*(U+V*k) := by
        rw [hbase, hslope]
        simp [Nat.mul_add, Nat.mul_assoc]
  have hprod : V*k <= M*k := Nat.mul_le_mul_right k hs
  exact And.intro (partial_halving_reach _ _ _ hodd hpartial) (by omega)

/-- Teaching/negative-control family: partial endpoint 2+3*k may be even. -/
theorem five_mod_eight (k : Nat) :
    OrdinaryReach (5+8*k) (2+3*k) /\ 2+3*k < 5+8*k := by
  exact affine_partial_halving_descent 5 8 2 3 5 8 3 k
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)

